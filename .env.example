# Environment
NODE_ENV=development
PORT=3000

# Admin
ADMIN_EMAIL=admin@example.com

# Database (Required)
DATABASE_URL=postgresql://user:password@localhost:5432/qnya

# Database Pool Configuration
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# Redis (Required)
REDIS_URL=redis://localhost:6379

# Session (Required)
SESSION_DOMAIN=your-domain
SESSION_SECRET=your-super-secret-key
SESSION_MAX_AGE=604800000
SESSION_RENEW_THRESHOLD=86400000

# Security (Required)
RATE_LIMIT_MAX=100
CORS_ORIGINS=http://localhost:3000

# SMTP (Required)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Qnya <noreply@example.com>

# qBittorrent
QBIT_HOST=qbit.example.com
QBIT_USERNAME=
QBIT_PASSWORD=
QBIT_DOWNLOAD_PATH=
QBIT_HOST_DOWNLOAD_PATH=
QBIT_WEBHOOK_SECRET=

# Resource
RESOURCE_ROOT_PATH=

# TMDB
TMDB_API_KEY=
TMDB_IMAGE_DOMAIN=image.tmdb.org
TMDB_API_DOMAIN=api.themoviedb.org